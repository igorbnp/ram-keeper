#!/bin/bash
# ram-keeper: announce only the moments a human actually wants to know about.
#
# This follows the pattern omarchy-crash-watch uses, deliberately: never spin
# up an LLM to watch a number, because a number does not need reasoning. Wake
# the agent only when there is evidence of a real problem, and only when a
# human clicks to hear about it.
#
# Three kinds of moment earn a toast:
#   1. The daemon itself failed — the important one. If ram-keeper dies
#      silently, the user believes they are protected and are not.
#   2. systemd-oomd actually killed something. RAM Keeper's whole purpose is
#      to make that never happen, so its occurrence is a real report.
#   3. Memory went critical and stayed there.
#
# What is deliberately NOT here: a periodic "memory is at 42%" report. That is
# the same sentence every time, and it trains the user to dismiss toasts —
# which would cost us the alerts that matter.
#
# Every toast carries `Click to ...` and a command, so clicking opens the
# agent with the context already gathered. No LLM runs until that click.

set -uo pipefail

readonly STATE_DIR="${RAM_KEEPER_STATE_DIR:-$HOME/.local/state/ram-keeper}"
readonly FLAG_DIR="$STATE_DIR/flags"
readonly LOG="$STATE_DIR/log.jsonl"
readonly PIDFILE="$STATE_DIR/notify.pid"
readonly RATE_FILE="$FLAG_DIR/.rate-timestamps"
readonly DEDUPE_SECONDS=${RAM_KEEPER_DEDUPE_SECONDS:-1800}
# Poll intervals, overridable so the test suite can exercise a transition in
# seconds instead of waiting 15 and 30 of them.
readonly DAEMON_POLL=${RAM_KEEPER_DAEMON_POLL:-15}
readonly PRESSURE_POLL=${RAM_KEEPER_PRESSURE_POLL:-30}
readonly UNIT=ram-keeper.service

# Global anti-flood ceiling: at most 3 notifications in any 300-second window.
readonly RATE_LIMIT_WINDOW=${RAM_KEEPER_RATE_WINDOW:-300}
readonly RATE_LIMIT_MAX=${RAM_KEEPER_RATE_MAX:-3}

declare -A MEM_DEDUPE=()
declare -a TOAST_TIMESTAMPS=()
declare -a SUP_PIDS=()

# python3 is already a hard dependency of this plugin (the daemon is written in
# it), so parse the snapshot with it instead of adding a jq dependency. A
# missing jq used to make watch_pressure read state="" forever: a watcher that
# is dead code but looks alive.
PYTHON3="${RAM_KEEPER_PYTHON:-/usr/bin/python3}"
[[ -x "$PYTHON3" ]] || PYTHON3="$(command -v python3 2>/dev/null || true)"

# The skill path is resolved at click time, not install time: a Hermes profile
# switch or a skill reinstall must not leave the notifier pointing at a stale
# path.
skill_path() {
  local root candidate
  root="${HERMES_HOME:-$HOME/.hermes}"
  for candidate in "$root/skills/ram-memory-diagnosis/SKILL.md" \
                   "$root/profiles/"*/skills/ram-memory-diagnosis/SKILL.md; do
    [[ -f "$candidate" ]] && { echo "$candidate"; return 0; }
  done
  echo "$root/skills/ram-memory-diagnosis/SKILL.md"
}

mkdir -p "$FLAG_DIR" 2>/dev/null || true

# nf-md-memory_alert / nf-md-check, escaped so this file reads without a Nerd Font.
readonly ALERT_GLYPH=$'\U000f0535'

log_event() {
  printf '{"ts":%s,"event":"%s"}\n' "$(date +%s)" "$1" >>"$LOG" 2>/dev/null || true
}

# Keep the dedupe directory bounded. OOM lines embed a PID and an RSS, so they
# never collide: without pruning, a crash-looping app adds one file per boot,
# permanently, and nothing ever removes them.
prune_flags() {
  local keep="${1:-200}"
  local -a all=()
  mapfile -t all < <(ls -1t "$FLAG_DIR"/oom-* "$FLAG_DIR"/pressure-* 2>/dev/null) || return 0
  (( ${#all[@]} <= keep )) && return 0
  rm -f "${all[@]:keep}" 2>/dev/null || true
}

# Check eligibility WITHOUT writing the dedupe marker yet. Writing before
# send() used to mute critical alerts for 30 minutes whenever the notification
# daemon was not ready yet at login.
can_announce() {
  local key="$1" marker="$FLAG_DIR/$1" now mem_ts
  now=$(date +%s)
  if [[ -e "$marker" ]]; then
    local age=$(( now - $(stat -c %Y "$marker" 2>/dev/null || echo 0) ))
    (( age < DEDUPE_SECONDS )) && return 1
  fi
  mem_ts="${MEM_DEDUPE[$key]:-0}"
  if (( mem_ts > 0 && now - mem_ts < DEDUPE_SECONDS )); then
    return 1
  fi
  return 0
}

# Commit the dedupe window only AFTER send() succeeded. Falls back to in-memory
# tracking when STATE_DIR is read-only (EROFS) or out of space (ENOSPC).
mark_announced() {
  local key="$1" marker="$FLAG_DIR/$1" now
  now=$(date +%s)
  MEM_DEDUPE["$key"]="$now"
  if touch "$marker" 2>/dev/null; then
    prune_flags 200
  else
    log_event "dedupe-mem-fallback"
  fi
}

# Global rate-limit across all watchers via $RATE_FILE (falling back to
# in-memory TOAST_TIMESTAMPS when disk is not writable).
rate_limit_check_and_record() {
  local mode="$1" now cutoff ts
  now=$(date +%s)
  cutoff=$(( now - RATE_LIMIT_WINDOW ))

  if mkdir -p "$FLAG_DIR" 2>/dev/null && [[ -w "$FLAG_DIR" ]]; then
    local -a kept=()
    if [[ -f "$RATE_FILE" ]]; then
      while IFS= read -r ts; do
        [[ "$ts" =~ ^[0-9]+$ ]] && (( ts > cutoff )) && kept+=("$ts")
      done <"$RATE_FILE"
    fi
    if [[ "$mode" == "check" ]]; then
      (( ${#kept[@]} < RATE_LIMIT_MAX ))
      return $?
    fi
    kept+=("$now")
    printf '%s\n' "${kept[@]}" >"$RATE_FILE.tmp.$$" 2>/dev/null \
      && mv -f "$RATE_FILE.tmp.$$" "$RATE_FILE" 2>/dev/null || rm -f "$RATE_FILE.tmp.$$" 2>/dev/null
    return 0
  fi

  local -a live=()
  for ts in "${TOAST_TIMESTAMPS[@]:-}"; do
    [[ -n "${ts:-}" ]] && (( ts > cutoff )) && live+=("$ts")
  done
  TOAST_TIMESTAMPS=("${live[@]:-}")
  if [[ "$mode" == "check" ]]; then
    (( ${#TOAST_TIMESTAMPS[@]} < RATE_LIMIT_MAX ))
    return $?
  fi
  TOAST_TIMESTAMPS+=("$now")
  return 0
}

# Strict whitelist for process/unit names extracted from untrusted log text:
# strips shell/prompt metacharacters and leading dashes, max 48 characters.
sanitize_victim() {
  local raw="$1" clean
  clean="${raw//[^A-Za-z0-9._@-]/}"
  clean="${clean#"${clean%%[A-Za-z0-9_@]*}"}"
  printf '%s' "${clean:0:48}"
}

# Return codes:
#   0 = delivered
#   1 = transient failure (notification server unready or send failed)
#   2 = dropped by global anti-flood rate-limit
send() {
  local urgency="$1" glyph="$2" title="$3" body="$4" action="$5"
  if ! rate_limit_check_and_record check; then
    log_event "rate-limited"
    return 2
  fi
  omarchy-notification-wait 5 || {
    log_event "notify-server-unready"
    return 1
  }
  if omarchy-notification-send \
    --urgency "$urgency" \
    --glyph "$glyph" \
    "$title" \
    "$body" \
    --exec bash -lc "$action"; then
    rate_limit_check_and_record record
    return 0
  fi
  log_event "notify-send-failed"
  return 1
}

# Build the click action as a single shell command string.
agent_action() {
  local prompt="$1" skill lead
  skill="$(skill_path)"
  if [[ -n "$skill" && -f "$skill" ]]; then
    lead="Read and follow the skill at $skill."
  else
    lead="Explain the memory situation from the numbers in this prompt."
  fi
  printf 'omarchy agent prompt %q' "$lead

$prompt"
}

# ---------------------------------------------------------------------------
# 1. The daemon died — the one thing that must never be silent
# ---------------------------------------------------------------------------
watch_daemon() {
  local was_alive="" rc=0
  while true; do
    if systemctl --user is-active --quiet "$UNIT"; then
      was_alive=1
    elif [[ -f "$STATE_DIR/paused-by-user" ]]; then
      # The panel or CLI wrote this before pausing. A pause is not a crash.
      was_alive=0
    elif [[ "$was_alive" == "1" ]]; then
      log_event "daemon-down"
      if ! can_announce daemon-down; then
        was_alive=0
      else
        send critical "$ALERT_GLYPH" \
          "RAM protection stopped" \
          "ram-keeper is not running. Click to restart it." \
          'systemctl --user restart ram-keeper.service; omarchy-shell io.github.igorbnp.ram-keeper refresh'
        rc=$?
        if (( rc == 0 )); then
          mark_announced daemon-down
          was_alive=0
        elif (( rc == 2 )); then
          was_alive=0
        fi
        # rc == 1 keeps was_alive=1 so the next poll retries delivery.
      fi
    fi
    sleep "$DAEMON_POLL"
  done
}

# ---------------------------------------------------------------------------
# 2. A process was actually killed for using too much memory
# ---------------------------------------------------------------------------
_oom_state_context() {
  [[ -f "$STATE_DIR/state.json" && -n "$PYTHON3" ]] || return 0
  "$PYTHON3" -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        d = json.load(fh)
except Exception:
    raise SystemExit(0)
if not isinstance(d, dict):
    raise SystemExit(0)
fc = d.get("forecast") if isinstance(d.get("forecast"), dict) else {}
culprit = fc.get("culprit", "")
relief = d.get("relief") if isinstance(d.get("relief"), dict) else {}
stats = d.get("session_stats") if isinstance(d.get("session_stats"), dict) else {}
freed = 0
for cand in (relief.get("freed"), relief.get("freed_bytes"), stats.get("last_relief_bytes")):
    if isinstance(cand, (int, float)) and not isinstance(cand, bool) and cand > 0:
        freed = int(cand)
        break
parts = []
if isinstance(culprit, str) and culprit:
    clean = "".join(c for c in culprit if c.isalnum() or c in "._@- ").strip()[:48]
    if clean:
        parts.append("culprit=" + clean)
if freed >= 1048576:
    parts.append(f"last_reclaimed={freed // 1048576}MB")
if parts:
    print(", ".join(parts))
' "$STATE_DIR/state.json" 2>/dev/null || true
}

_handle_oom_line() {
  local line="$1" key victim="" raw_unit="" ctx="" rc=0
  [[ "$line" == *ram-keeper* ]] && return 0
  [[ "$line" == *ram-memory-diagnosis* ]] && return 0
  [[ "$line" == *"just killed a process on this machine"* ]] && return 0
  [[ "$line" == *"use too much memory"* ]] && return 0

  key="oom-$(printf '%s' "$line" | md5sum | cut -c1-8)"
  can_announce "$key" || return 0
  log_event "oom-kill"

  if [[ "$line" =~ [Kk]illed\ process\ [0-9]+\ \(([^\)]+)\) ]]; then
    victim="${BASH_REMATCH[1]}"
  elif [[ "$line" =~ [Mm]arked\ (.+)\ for\ killing ]]; then
    raw_unit="${BASH_REMATCH[1]}"
    victim="$(basename -- "$raw_unit" 2>/dev/null || true)"
    victim="${victim%.scope}"
    victim="${victim%.service}"
  fi
  victim="$(sanitize_victim "$victim")"
  ctx="$(_oom_state_context)"

  local title body prompt_text
  if [[ -n "$victim" ]]; then
    title="Process closed: $victim ran out of memory"
    body="The system stopped $victim to protect your desktop. Click to diagnose."
    prompt_text="The system OOM killer stopped the process '$victim' for using too much memory. Use the ram-memory-diagnosis skill to work out what happened and what to change."
  else
    title="A process was killed for using too much memory"
    body="RAM Keeper should have prevented this. Click to find out what happened."
    prompt_text="systemd-oomd just killed a process on this machine for using too much memory. Use the ram-memory-diagnosis skill to work out what happened and what to change."
  fi
  if [[ -n "$ctx" ]]; then
    prompt_text="$prompt_text Measured context: $ctx."
  fi

  send critical "$ALERT_GLYPH" "$title" "$body" "$(agent_action "$prompt_text")"
  rc=$?
  if (( rc == 1 )); then
    sleep 1
    send critical "$ALERT_GLYPH" "$title" "$body" "$(agent_action "$prompt_text")"
    rc=$?
  fi
  if (( rc == 0 )); then
    mark_announced "$key"
  fi
}

_watch_oom_plain() {
  local line
  while IFS= read -r line; do
    _handle_oom_line "$line"
  done < <(
    journalctl -f -n 0 -o cat 2>/dev/null \
      | grep --line-buffered -iE 'memory cgroup out of memory|for killing due to memory pressure'
  )
}

watch_oom_kills() {
  # Test-only plain mode for stub suites that emit unformatted lines.
  if [[ "${RAM_KEEPER_TRUST_STUB_JOURNAL:-}" == "1" ]]; then
    _watch_oom_plain
    return
  fi
  [[ -n "$PYTHON3" ]] || { sleep 30; return; }

  # Authenticate journal entries via JSON metadata: only _TRANSPORT=kernel or
  # _SYSTEMD_UNIT=systemd-oomd.service can trigger an OOM alert. Unprivileged
  # processes writing to stdout/journal cannot forge _TRANSPORT=kernel.
  local msg
  while IFS= read -r msg; do
    [[ -n "$msg" ]] && _handle_oom_line "$msg"
  done < <(
    journalctl -f -n 0 -o json 2>/dev/null | "$PYTHON3" -u -c '
import json, sys
NEEDLES = ("memory cgroup out of memory", "for killing due to memory pressure")
for raw in sys.stdin:
    try:
        d = json.loads(raw)
    except Exception:
        continue
    if not isinstance(d, dict):
        continue
    if d.get("_TRANSPORT") != "kernel" and d.get("_SYSTEMD_UNIT") != "systemd-oomd.service":
        continue
    m = d.get("MESSAGE", "")
    if isinstance(m, list):
        try:
            m = bytes(int(x) & 0xFF for x in m).decode("utf-8", "replace")
        except Exception:
            continue
    if not isinstance(m, str):
        continue
    clean = " ".join(m.splitlines()).strip()
    low = clean.lower()
    if any(n in low for n in NEEDLES):
        print(clean, flush=True)
' 2>/dev/null
  )
}

# ---------------------------------------------------------------------------
# 3. Memory critical and staying there
# ---------------------------------------------------------------------------

# Prints 7 tab-separated fields using "-" for empty values so bash `IFS=$'\t'
# read -r` never collapses adjacent tabs.
snapshot_fields() {
  [[ -n "$PYTHON3" ]] || return 1
  printf '%s' "$1" | "$PYTHON3" -c 'import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
if not isinstance(d, dict):
    raise SystemExit(1)
free = d.get("free_percent")
if isinstance(free, bool) or not isinstance(free, (int, float)):
    raise SystemExit(1)
relief = d.get("relief") if isinstance(d.get("relief"), dict) else {}
acted = relief.get("acted")
acted_s = "yes" if acted is True else "no" if acted is False else ""
skipped = relief.get("skipped_anon") if isinstance(relief.get("skipped_anon"), str) else ""
skipped = "".join(ch for ch in skipped if ch.isalnum() or ch in "-_")[:40]
raw_held = d.get("held_by") if isinstance(d.get("held_by"), list) else []
names = []
for item in raw_held:
    if not isinstance(item, str):
        continue
    clean = "".join(ch for ch in item if ch.isprintable() and ch not in "\t\r\n").strip()
    if clean:
        names.append(clean[:80])
fc = d.get("forecast") if isinstance(d.get("forecast"), dict) else {}
culprit = fc.get("culprit", "") if isinstance(fc.get("culprit"), str) else ""
culprit = "".join(ch for ch in culprit if ch.isalnum() or ch in "._@- ").strip()[:48]
stats = d.get("session_stats") if isinstance(d.get("session_stats"), dict) else {}
freed_b = 0
for cand in (relief.get("freed"), relief.get("freed_bytes"), stats.get("last_relief_bytes")):
    if isinstance(cand, (int, float)) and not isinstance(cand, bool) and cand > 0:
        freed_b = int(cand)
        break
freed_mb = str(freed_b // 1048576) if freed_b >= 1048576 else ""
cols = [str(d.get("state") or "unknown"), str(free), acted_s, skipped, ", ".join(names[:8]), culprit, freed_mb]
print("\t".join(c if c else "-" for c in cols))' 2>/dev/null
}

watch_pressure() {
  local last_state=""
  while true; do
    [[ -f "$STATE_DIR/state.json" ]] || { sleep "$PRESSURE_POLL"; continue; }

    local snapshot state free fields acted skipped held culprit freed_mb body prompt_ctx rc=0
    snapshot="$(cat "$STATE_DIR/state.json" 2>/dev/null)"
    if ! fields="$(snapshot_fields "$snapshot")" || [[ -z "$fields" ]]; then
      sleep "$PRESSURE_POLL"
      continue
    fi
    IFS=$'\t' read -r state free acted skipped held culprit freed_mb <<<"$fields"
    [[ "$acted" == "-" ]] && acted=""
    [[ "$skipped" == "-" ]] && skipped=""
    [[ "$held" == "-" ]] && held=""
    [[ "$culprit" == "-" ]] && culprit=""
    [[ "$freed_mb" == "-" ]] && freed_mb=""

    if [[ "$state" == "critical" && "$last_state" != "critical" ]]; then
      if ! can_announce pressure-critical; then
        last_state="$state"
      else
        log_event "pressure-critical"
        if [[ -n "$held" ]]; then
          body="Only ${free}% free. Protected apps are holding the memory: ${held}."
        elif [[ "$acted" == "yes" && -n "$freed_mb" ]]; then
          body="Only ${free}% free. RAM Keeper is reclaiming now (${freed_mb} MB freed). Click if the machine feels slow."
        elif [[ "$acted" == "yes" ]]; then
          body="Only ${free}% free. RAM Keeper is reclaiming now. Click if the machine feels slow."
        elif [[ "$skipped" == "no-zram-room" ]]; then
          body="Only ${free}% free. App memory was not moved to disk swap."
        elif [[ "$skipped" == "psi-full-thrash" ]]; then
          body="Only ${free}% free. Swap paused due to thrashing."
        else
          body="Only ${free}% free. Click if the machine feels slow."
        fi
        if [[ -n "$culprit" ]]; then
          body="$body Biggest grower: $culprit."
        fi
        prompt_ctx="RAM Keeper reported critical memory pressure: only ${free}% of RAM free."
        [[ -n "$culprit" ]] && prompt_ctx="$prompt_ctx Fastest-growing group: $culprit."
        [[ -n "$freed_mb" ]] && prompt_ctx="$prompt_ctx Last pass reclaimed ${freed_mb} MB."
        send critical "$ALERT_GLYPH" \
          "Memory is critically low" \
          "$body" \
          "$(agent_action "$prompt_ctx Use the ram-memory-diagnosis skill to explain what is using the memory and whether anything needs to change.")"
        rc=$?
        if (( rc == 0 )); then
          mark_announced pressure-critical
          last_state="$state"
        elif (( rc == 2 )); then
          last_state="$state"
        fi
        # rc == 1 leaves last_state unchanged so the next poll retries delivery.
      fi
    elif [[ "$state" != "critical" ]]; then
      last_state="$state"
    fi
    sleep "$PRESSURE_POLL"
  done
}

# ---------------------------------------------------------------------------
# Supervision & single-instance lock
# ---------------------------------------------------------------------------
_kill_tree() {
  local target="$1" child
  [[ -n "$target" ]] || return 0
  if [[ -r "/proc/$target/task/$target/children" ]]; then
    for child in $(cat "/proc/$target/task/$target/children" 2>/dev/null); do
      _kill_tree "$child"
    done
  elif command -v ps >/dev/null 2>&1; then
    for child in $(ps -o pid= --ppid "$target" 2>/dev/null); do
      _kill_tree "$child"
    done
  fi
  kill -TERM "$target" 2>/dev/null || true
}

supervise() {
  # Do not let watcher subprocesses inherit the pidfile flock FD.
  exec 9>&- 2>/dev/null || true
  local name="$1"; shift
  trap 'exit 0' INT TERM HUP
  while true; do
    "$@"
    log_event "watcher-exited:$name"
    sleep 5
  done
}

pid_is_this_script() {
  local pid="$1"
  [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -r "/proc/$pid/cmdline" ]] || return 1
  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'ram_keeper_notify'
}

cleanup_notifier() {
  trap - EXIT INT TERM HUP
  local p
  for p in "${SUP_PIDS[@]:-}"; do
    [[ -n "${p:-}" ]] && _kill_tree "$p"
  done
  rm -f "$PIDFILE" 2>/dev/null || true
  exec 9>&- 2>/dev/null || true
}

main() {
  # Nothing to say until a notification path exists; exit cleanly before
  # touching PIDFILE so we never clobber another instance's lock.
  command -v omarchy-notification-send >/dev/null || exit 0

  local old_pid=""
  if [[ -f "$PIDFILE" ]]; then
    old_pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  fi

  if command -v flock >/dev/null 2>&1 && ( exec 9>>"$PIDFILE" ) 2>/dev/null; then
    exec 9>>"$PIDFILE"
    if ! flock -n 9; then
      exit 0
    fi
    if [[ -n "$old_pid" && "$old_pid" != "$$" ]]; then
      if pid_is_this_script "$old_pid"; then
        exit 0
      fi
      log_event "stale-pidfile"
    fi
    printf '%s\n' "$$" >"$PIDFILE" 2>/dev/null || true
  else
    if [[ -n "$old_pid" ]]; then
      if pid_is_this_script "$old_pid"; then
        exit 0
      fi
      log_event "stale-pidfile"
    fi
    printf '%s\n' "$$" >"$PIDFILE" 2>/dev/null || true
  fi

  trap 'cleanup_notifier; exit 0' INT TERM HUP
  trap 'cleanup_notifier' EXIT

  [[ -n "$PYTHON3" ]] || log_event "no-python3"

  supervise daemon watch_daemon &
  SUP_PIDS+=("$!")
  supervise pressure watch_pressure &
  SUP_PIDS+=("$!")
  supervise oom watch_oom_kills &
  SUP_PIDS+=("$!")
  wait
}

main "$@"
